# --- Server ---
PORT=3000
NODE_ENV=development

# --- Branding (used in emails and support tickets) ---
APP_NAME=App Starter
# Base URL of the frontend, used to build password-reset links
APP_BASE_URL=http://localhost:5173

# --- Database (PostgreSQL only) ---
# Option A: single connection string (Railway/Heroku style; SSL enabled automatically)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Option B: individual settings (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_starter_dev
DB_USER=postgres
DB_PASSWORD=postgres
# DB_SSL=true

# --- Auth ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Force secure cookies on/off; defaults to on in production only
# COOKIE_SECURE=true
# CORS_ORIGIN=https://app.example.com

# --- Seed admin (first run only, when the users table is empty) ---
# Both must be set; ADMIN_PASSWORD must be 12+ characters. Disable after first boot.
ALLOW_DEFAULT_ADMIN_SEED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Email via Resend (password reset + support tickets) ---
# RESEND_API_KEY=
# Verified sender, e.g. "App Starter <no-reply@yourdomain.com>"
# FROM_EMAIL=
# Where support tickets are delivered
# SUPPORT_EMAIL=support@example.com

# --- Optional: support tickets also create GitHub issues ---
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
